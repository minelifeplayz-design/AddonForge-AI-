{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A Minecraft addon project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "type": { "enum": ["behavior", "resource", "both"] },
        "version": { "type": "string" },
        "minGameVersion": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "files": { "type": "object" },
        "userId": { "type": "string" }
      },
      "required": ["id", "name", "type", "userId", "createdAt"]
    },
    "CommunityAddon": {
      "title": "CommunityAddon",
      "description": "An addon shared with the community",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "createdAt": { "type": "number" },
        "expiresAt": { "type": "number" }
      },
      "required": ["id", "projectId", "authorId", "name", "downloadUrl", "createdAt", "expiresAt"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "User projects"
    },
    "/community_addons/{addonId}": {
      "schema": "CommunityAddon",
      "description": "Community shared addons"
    }
  }
}
